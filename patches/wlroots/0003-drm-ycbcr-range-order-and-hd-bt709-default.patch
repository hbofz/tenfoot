diff -ru a/include/backend/drm/properties.h b/include/backend/drm/properties.h
--- a/include/backend/drm/properties.h	2026-10-21 17:34:51.656831611 -0500
+++ b/include/backend/drm/properties.h	2026-10-21 17:34:51.722863347 -0500
@@ -77,10 +77,12 @@
 	WLR_DRM_COLOR_YCBCR_BT2020,
 };
 
-// Equivalent to wlr_drm_color_range defined in the kernel (but not exported)
+// Equivalent to drm_color_range defined in the kernel (but not exported), in
+// the same order: limited is 0. In the other order, every "limited" plane went
+// out as full range and the other way about.
 enum wlr_drm_color_range {
-	WLR_DRM_COLOR_YCBCR_FULL_RANGE,
 	WLR_DRM_COLOR_YCBCR_LIMITED_RANGE,
+	WLR_DRM_COLOR_YCBCR_FULL_RANGE,
 };
 
 bool get_drm_connector_props(int fd, uint32_t id,
diff -ru a/render/egl.c b/render/egl.c
--- a/render/egl.c	2026-10-21 17:34:51.670151244 -0500
+++ b/render/egl.c	2026-10-21 17:34:51.730606550 -0500
@@ -851,6 +851,14 @@
 		}
 	}
 
+	// Without colour information, YUV video of HD size is taken to be BT.709, as
+	// players do (and as the DRM backend does when it scans such a buffer out).
+	if ((color_repr == NULL || color_repr->coefficients == 0) && attributes->height >= 720 &&
+			attributes->n_planes > 1) {
+		attribs[atti++] = EGL_YUV_COLOR_SPACE_HINT_EXT;
+		attribs[atti++] = EGL_ITU_REC709_EXT;
+	}
+
 	// Our clients don't expect our usage to trash the buffer contents
 	attribs[atti++] = EGL_IMAGE_PRESERVED_KHR;
 	attribs[atti++] = EGL_TRUE;
